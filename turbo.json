{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "vitest.config.ts",
    "biome.json",
    "conformance/**",
    "conformance.json",
    "scripts/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:smoke": {
      "dependsOn": ["build"]
    }
  }
}
