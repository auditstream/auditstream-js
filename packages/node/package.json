{
  "name": "@auditstream/node",
  "version": "0.2.1",
  "description": "Request actor context, Hono, Express and Next.js middleware, and driver wrappers for the Auditstream database audit trail engine",
  "keywords": [
    "audit-trail",
    "audit-log",
    "audit",
    "database",
    "postgresql",
    "sqlcommenter",
    "asynclocalstorage",
    "middleware",
    "hono",
    "express",
    "nextjs",
    "ai-agents"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://auditstream.dev/docs/typescript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/auditstream/auditstream-js.git",
    "directory": "packages/node"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "default": "./dist/express.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./pg": {
      "types": "./dist/pg.d.mts",
      "default": "./dist/pg.mjs"
    },
    "./postgres-js": {
      "types": "./dist/postgres-js.d.mts",
      "default": "./dist/postgres-js.mjs"
    },
    "./neon-http": {
      "types": "./dist/neon-http.d.mts",
      "default": "./dist/neon-http.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "hono": "^4.0.0",
    "next": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@auditstream/test-utils": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "express": "catalog:",
    "fast-check": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
